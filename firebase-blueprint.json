{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User business profile identity synced to Firestore",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Shopkeeper email" },
        "shopName": { "type": "string", "description": "Shop Name" },
        "address": { "type": "string", "description": "Shop Address" },
        "phone": { "type": "string", "description": "Shopkeeper Phone Number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["userId", "email", "shopName", "address", "phone", "createdAt"]
    },
    "SyncedBusiness": {
      "title": "Synced Business Profile",
      "description": "Full business profile settings stored offline and synced per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "localId": { "type": "integer" },
        "businessName": { "type": "string" },
        "ownerName": { "type": "string" },
        "tagline": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pinCode": { "type": "string" },
        "category": { "type": "string" },
        "isGstRegistered": { "type": "boolean" },
        "gstin": { "type": "string" },
        "financialYear": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "invoicePrefix": { "type": "string" },
        "nextInvoiceNumber": { "type": "integer" },
        "upiId": { "type": "string" },
        "signatureLabel": { "type": "string" },
        "defaultTerms": { "type": "string" },
        "localUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "localId",
        "businessName",
        "category",
        "isGstRegistered",
        "currencySymbol",
        "invoicePrefix",
        "nextInvoiceNumber",
        "localUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedProduct": {
      "title": "Synced Product",
      "description": "Inventory product catalog & stock state synced offline and online per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "localId": { "type": "integer" },
        "businessId": { "type": "integer" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "productCode": { "type": "string" },
        "hsnSacCode": { "type": "string" },
        "categoryName": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "purchasePricePaise": { "type": "integer" },
        "sellingPricePaise": { "type": "integer" },
        "wholesalePricePaise": { "type": "integer" },
        "wholesaleMinQtyScaled": { "type": "integer" },
        "mrpPaise": { "type": "integer" },
        "taxRatePercentScaled": { "type": "integer" },
        "isTaxInclusive": { "type": "boolean" },
        "unitName": { "type": "string" },
        "openingStockScaled": { "type": "integer" },
        "currentStockScaled": { "type": "integer" },
        "minStockScaled": { "type": "integer" },
        "batchNumber": { "type": "string" },
        "expiryDateMillis": { "type": "integer" },
        "garmentSize": { "type": "string" },
        "garmentColor": { "type": "string" },
        "garmentStyle": { "type": "string" },
        "serialNumber": { "type": "string" },
        "warrantyMonths": { "type": "integer" },
        "isServiceItem": { "type": "boolean" },
        "isRawMaterial": { "type": "boolean" },
        "defaultDiscountPercentScaled": { "type": "integer" },
        "trackExpiry": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "localCreatedAt": { "type": "integer" },
        "localUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "localId",
        "businessId",
        "name",
        "purchasePricePaise",
        "sellingPricePaise",
        "wholesalePricePaise",
        "wholesaleMinQtyScaled",
        "mrpPaise",
        "taxRatePercentScaled",
        "isTaxInclusive",
        "unitName",
        "openingStockScaled",
        "currentStockScaled",
        "minStockScaled",
        "isServiceItem",
        "isRawMaterial",
        "defaultDiscountPercentScaled",
        "trackExpiry",
        "isActive",
        "localCreatedAt",
        "localUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedInvoice": {
      "title": "Synced Invoice",
      "description": "Sales invoices, POS bills, estimates, quotations, and credit/return records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "localId": { "type": "integer" },
        "businessId": { "type": "integer" },
        "invoiceNumber": { "type": "string" },
        "documentType": { "type": "string" },
        "status": { "type": "string" },
        "invoiceDateMillis": { "type": "integer" },
        "dueDateMillis": { "type": "integer" },
        "customerId": { "type": "integer" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "customerGstin": { "type": "string" },
        "isInterState": { "type": "boolean" },
        "subtotalPaise": { "type": "integer" },
        "itemDiscountPaise": { "type": "integer" },
        "invoiceDiscountPercentScaled": { "type": "integer" },
        "invoiceDiscountFlatPaise": { "type": "integer" },
        "taxableAmountPaise": { "type": "integer" },
        "cgstPaise": { "type": "integer" },
        "sgstPaise": { "type": "integer" },
        "igstPaise": { "type": "integer" },
        "totalTaxPaise": { "type": "integer" },
        "additionalChargesPaise": { "type": "integer" },
        "shippingChargesPaise": { "type": "integer" },
        "roundOffPaise": { "type": "integer" },
        "grandTotalPaise": { "type": "integer" },
        "paidAmountPaise": { "type": "integer" },
        "balanceDuePaise": { "type": "integer" },
        "paymentMode": { "type": "string" },
        "paymentReference": { "type": "string" },
        "loyaltyPointsEarned": { "type": "integer" },
        "loyaltyPointsRedeemed": { "type": "integer" },
        "loyaltyDiscountPaise": { "type": "integer" },
        "tableNumber": { "type": "string" },
        "kotStatus": { "type": "string" },
        "linkedOriginalInvoiceId": { "type": "integer" },
        "notes": { "type": "string" },
        "termsAndConditions": { "type": "string" },
        "localCreatedAt": { "type": "integer" },
        "localUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "localId",
        "businessId",
        "invoiceNumber",
        "documentType",
        "status",
        "invoiceDateMillis",
        "customerName",
        "isInterState",
        "subtotalPaise",
        "itemDiscountPaise",
        "invoiceDiscountPercentScaled",
        "invoiceDiscountFlatPaise",
        "taxableAmountPaise",
        "cgstPaise",
        "sgstPaise",
        "igstPaise",
        "totalTaxPaise",
        "additionalChargesPaise",
        "shippingChargesPaise",
        "roundOffPaise",
        "grandTotalPaise",
        "paidAmountPaise",
        "balanceDuePaise",
        "paymentMode",
        "loyaltyPointsEarned",
        "loyaltyPointsRedeemed",
        "loyaltyDiscountPaise",
        "localCreatedAt",
        "localUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedInvoiceItem": {
      "title": "Synced Invoice Item",
      "description": "Line item belonging to a synced invoice",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "invoiceLocalId": { "type": "integer" },
        "productId": { "type": "integer" },
        "batchId": { "type": "integer" },
        "productName": { "type": "string" },
        "productCode": { "type": "string" },
        "hsnSacCode": { "type": "string" },
        "unitName": { "type": "string" },
        "quantityScaled": { "type": "integer" },
        "ratePaise": { "type": "integer" },
        "purchaseCostPaise": { "type": "integer" },
        "discountPercentScaled": { "type": "integer" },
        "discountAmountPaise": { "type": "integer" },
        "taxRatePercentScaled": { "type": "integer" },
        "isTaxInclusive": { "type": "boolean" },
        "taxableAmountPaise": { "type": "integer" },
        "cgstPaise": { "type": "integer" },
        "sgstPaise": { "type": "integer" },
        "igstPaise": { "type": "integer" },
        "lineTotalPaise": { "type": "integer" },
        "batchNumber": { "type": "string" },
        "expiryDateMillis": { "type": "integer" },
        "serialNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "invoiceLocalId",
        "productName",
        "unitName",
        "quantityScaled",
        "ratePaise",
        "purchaseCostPaise",
        "discountPercentScaled",
        "discountAmountPaise",
        "taxRatePercentScaled",
        "isTaxInclusive",
        "taxableAmountPaise",
        "cgstPaise",
        "sgstPaise",
        "igstPaise",
        "lineTotalPaise",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User business profile identity document"
    },
    "/users/{userId}/businesses/{businessDocId}": {
      "schema": { "$ref": "#/entities/SyncedBusiness" },
      "description": "Business profiles owned by user"
    },
    "/users/{userId}/products/{productDocId}": {
      "schema": { "$ref": "#/entities/SyncedProduct" },
      "description": "Inventory products & stock counts owned by user"
    },
    "/users/{userId}/invoices/{invoiceDocId}": {
      "schema": { "$ref": "#/entities/SyncedInvoice" },
      "description": "Invoices & POS transactions owned by user"
    },
    "/users/{userId}/invoices/{invoiceDocId}/items/{itemDocId}": {
      "schema": { "$ref": "#/entities/SyncedInvoiceItem" },
      "description": "Line items under a user's invoice"
    }
  }
}
